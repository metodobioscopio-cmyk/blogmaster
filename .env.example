# Copie para .env e preencha. Sem STRIPE_SECRET_KEY o app roda em modo demonstração.
PORT=8787
DEFAULT_CURRENCY=BRL

# Stripe — crie os preços no dashboard e cole os IDs aqui
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_PRO_YEARLY=price_xxx
STRIPE_PRICE_AGENCY=price_xxx
STRIPE_PRICE_AGENCY_YEARLY=price_xxx

# Opcional: webhook para liberar plano após pagamento
STRIPE_WEBHOOK_SECRET=whsec_xxx
