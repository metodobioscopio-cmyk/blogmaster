# Copie para .env e preencha. NUNCA comite o .env real.

# --- chave da API xAI (console.x.ai) ---
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1

# --- modelos (troque sem editar código; SKUs mudam a cada trimestre) ---
GROK_MODEL=grok-4.3
GROK_MODEL_FAST=grok-4.1-fast

# --- fonte de dados do Reddit: fixture | manual | oauth ---
REDDIT_SOURCE=fixture
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=grok-reddit-ops/1.0 by u/seu_usuario

# --- operação ---
SUBREDDITS=investimentos,Goiania,brasil
MIN_SCORE=60
DAILY_DRAFT_CAP=8
DISCLOSURE_MODE=strict
LANGUAGE=pt-BR
MARKET=br

# --- controle de custo (o bot para quando estoura) ---
DAILY_BUDGET_USD=1.00
X_SEARCH_POSTS_BUDGET=200

# --- FASE 2: multicanal ---------------------------------------------------
# Cada canal só é ativado quando a chave existe. Sem chave = canal desligado.
# O validador (src/channels.py) roda ANTES de qualquer chamada de API.

# Grok Bot (agente persistente; inclui créditos de X API em planos pagos)
GROK_BOT_ENABLED=false

# X / Twitter (pay-per-use: US$0,015/post sem link, US$0,20 com link)
# X_BEARER_TOKEN=
# X_USER_TOKEN=
X_LINK_POSTS_MONTHLY_BUDGET=5

# Telegram (o mais barato para validar o fluxo)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# WhatsApp Cloud API — BR: marketing R$0,3217 / utility R$0,035
# WA_TOKEN=
# WA_PHONE_NUMBER_ID=
WA_SERVICE_FREE_TIER=1000

# Instagram / Messenger (janela de 24h; nunca DM frio)
# IG_TOKEN=
# IG_USER_ID=
# META_APP_SECRET=
META_WINDOW_HOURS=24

# TikTok (só publica de verdade depois do audit)
# TIKTOK_TOKEN=
TIKTOK_AUDITED=false

# YouTube (10.000 unidades/dia; resposta = 50 unidades)
# YT_ACCESS_TOKEN=
YOUTUBE_REPLIES_DAILY_CAP=198

# Threads e Bluesky (teste barato)
# THREADS_TOKEN=
# THREADS_USER_ID=
# BSKY_HANDLE=
# BSKY_APP_PASSWORD=

# Google Business Profile
# GBP_TOKEN=
# GBP_ACCOUNT_ID=
# GBP_LOCATION_ID=

# E-mail (compliance: sem unsubscribe/endereço/base legal o validador bloqueia)
# ESP_API_KEY=
EMAIL_FROM_NAME=
EMAIL_PHYSICAL_ADDRESS=
